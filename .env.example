# stub = offline demo + tests (no network). gemini = live LLM.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Leave empty to use in-process Qdrant and skip Redis (pytest / local).
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite:///./ops_sentry.db

# Optional live Postgres in Compose:
# DATABASE_URL=postgresql+psycopg://ops:ops@postgres:5432/ops_sentry
