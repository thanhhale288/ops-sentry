# stub = offline demo + tests (no network). gemini = live LLM.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Leave QDRANT_URL and REDIS_URL empty for local uvicorn (in-process Qdrant, no Redis).
# docker compose hardcodes Postgres/Qdrant/Redis on the `api` service — do not put
# docker hostnames (qdrant/redis/postgres) in this file; `cp .env.example .env` is
# for local uvicorn, and those names would fail DNS outside Compose.
QDRANT_URL=
REDIS_URL=
DATABASE_URL=sqlite:///./ops_sentry.db

# Empty token = open demo (pytest / compose default). production + empty token → 503.
OPS_API_TOKEN=
OPS_ENV=demo
